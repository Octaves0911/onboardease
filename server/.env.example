# Sandbox Server Configuration
SANDBOX_PORT=4010

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onboardease

# Host directory where user volumes are bind-mounted
# Docker must have read/write access to this path
SANDBOXES_ROOT=/sandboxes

# Idle timeout before pausing a container (ms). Default: 30 minutes
IDLE_TIMEOUT_MS=1800000
